    {
      "parameters": {
        "jsCode": "// Build chain_head.json + capture SHA, then write to eo-wiki (main).\nconst hook = $('Chain Head Webhook').first().json;\nlet body = hook.body != null ? hook.body : hook;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); }\n  catch (e) { return [{ json: { __invalid: true, error: 'body is not valid JSON' } }]; }\n}\n\nif (!body || !body.head_id) {\n  return [{ json: { __invalid: true, error: 'missing head_id in body' } }];\n}\n\nconst text = JSON.stringify({\n  head_id:         body.head_id,\n  head_hash:       body.head_hash || null,\n  next_index:      body.next_index || 0,\n  last_block_date: body.last_block_date || null,\n  last_aggregate:  body.last_aggregate || null,\n  published_at:    new Date().toISOString(),\n}, null, 2) + '\\n';\n\nconst ghResp = $input.first().json || {};\nconst existingSha = ghResp.sha || '';\n\nreturn [{ json: {\n  filename: 'chain_head.json',\n  message: 'chain head -> ' + body.head_id + ' (block ' + ((body.next_index || 1) - 1) + ')',\n  contentBase64: Buffer.from(text, 'utf8').toString('base64'),\n  sha: existingSha,\n  bytes: text.length,\n}}];"
      },
