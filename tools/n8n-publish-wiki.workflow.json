    {
      "parameters": {
        "jsCode": "// Build the article file content + capture SHA, then write to eo-wiki (main).\n// Body arrives as a JSON object, or a JSON string when the client sends\n// text/plain (which avoids a CORS preflight from the browser).\nconst hook = $('Publish Webhook').first().json;\nlet parsed = hook.body != null ? hook.body : hook;\nif (typeof parsed === 'string') {\n  try { parsed = JSON.parse(parsed); }\n  catch (e) { throw new Error('Build Content: body is not valid JSON'); }\n}\n\nconst filename   = parsed.filename;\nconst mode       = parsed.mode || 'overwrite';\nconst contentRaw = parsed.contentRaw != null ? String(parsed.contentRaw) : '';\nconst message    = parsed.message || ('update ' + filename);\nconst compress   = !!parsed.compress;\n\nif (!filename) {\n  throw new Error('Build Content: missing filename. Got keys: ' + Object.keys(parsed).join(','));\n}\n\n// GH Get File returns { content (base64), sha } on success, or a 404 error\n// object (continueOnFail). sha must be '' (not null) when absent.\nconst ghResp = $input.first().json || {};\nconst existingSha = ghResp.sha || '';\nconst existingB64 = ghResp.content || '';\n\nlet existingText = '';\nif (existingB64) {\n  try { existingText = Buffer.from(existingB64, 'base64').toString('utf8'); } catch (e) { existingText = ''; }\n}\n\nlet finalText;\nif (mode === 'append') {\n  const prev = existingText ? (existingText.endsWith('\\n') ? existingText : existingText + '\\n') : '';\n  const next = contentRaw.endsWith('\\n') ? contentRaw : contentRaw + '\\n';\n  finalText = prev + next;\n} else {\n  finalText = contentRaw;\n}\n\nlet b64;\nif (compress) {\n  const zlib = require('zlib');\n  b64 = zlib.gzipSync(Buffer.from(finalText, 'utf8')).toString('base64');\n} else {\n  b64 = Buffer.from(finalText, 'utf8').toString('base64');\n}\n\nreturn [{ json: { filename, message, contentBase64: b64, sha: existingSha, bytes: finalText.length } }];"
      },
