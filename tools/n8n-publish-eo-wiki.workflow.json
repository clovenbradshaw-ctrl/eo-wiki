    {
      "parameters": {
        "jsCode": "// Build the commit payload. Runs only after Authorize passed.\nconst hook = $('Publish Webhook').first().json;\nlet body = hook.body != null ? hook.body : hook;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); }\n  catch (e) { throw new Error('Build Content: body is not valid JSON'); }\n}\n\nconst az = $('Authorize').first().json;\nconst filename = az.filename;\nconst mode = az.mode;\nconst contentRaw = body.contentRaw != null ? String(body.contentRaw) : '';\nconst message = body.message || ((mode === 'delete' ? 'delete ' : 'update ') + filename);\n\n// GH Get File returns { content (base64), sha } on success, or a 404 error\n// object (continueOnFail). sha must be '' (not null) when absent.\nconst ghResp = $input.first().json || {};\nconst existingSha = ghResp.sha || '';\nconst existingB64 = ghResp.content || '';\n\nlet existingText = '';\nif (existingB64) { try { existingText = Buffer.from(existingB64, 'base64').toString('utf8'); } catch (e) {} }\n\nlet finalText = contentRaw;\nif (mode === 'append') {\n  const prev = existingText ? (existingText.endsWith('\\n') ? existingText : existingText + '\\n') : '';\n  finalText = prev + (contentRaw.endsWith('\\n') ? contentRaw : contentRaw + '\\n');\n}\n\nreturn [{ json: {\n  filename, mode, message,\n  contentBase64: Buffer.from(finalText, 'utf8').toString('base64'),\n  sha: existingSha,\n  bytes: mode === 'delete' ? 0 : finalText.length,\n} }];"
      },
