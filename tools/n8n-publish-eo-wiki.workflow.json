      "parameters": {
        "jsCode": "// Pull the Bearer token and the request basics out of the webhook payload.\n// The token is hashed by the next node (the built-in Crypto node) so this\n// workflow never needs require() — Code-node built-ins are often disabled.\nconst hook = $input.first().json;\nlet body = hook.body != null ? hook.body : hook;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nconst auth = (hook.headers && (hook.headers.authorization || hook.headers.Authorization)) || '';\nconst token = String(auth).replace(/^Bearer\\s+/i, '').trim();\nreturn [{ json: {\n  token,\n  hasToken: !!token,\n  filename: body && body.filename ? String(body.filename) : '',\n  mode: body && body.mode ? String(body.mode) : 'overwrite',\n} }];"
      },
